rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserTenantId() {
      return request.auth.token.tenantId;
    }
    
    function hasRole(role) {
      return isAuthenticated() && 
             role in request.auth.token.roles;
    }
    
    function isOwner(resourceUserId) {
      return isAuthenticated() && 
             request.auth.uid == resourceUserId;
    }
    
    function belongsToSameTenant(resourceTenantId) {
      return isAuthenticated() && 
             getUserTenantId() == resourceTenantId;
    }
    
    function isValidTenantData() {
      return belongsToSameTenant(resource.data.tenantId);
    }
    
    // Audit fields validation
    function hasValidAuditFields() {
      return request.resource.data.keys().hasAll(['createdBy', 'updatedBy', 'createdAt', 'updatedAt']) &&
             request.resource.data.createdBy == request.auth.uid &&
             request.resource.data.updatedBy == request.auth.uid;
    }
    
    function hasValidUpdateFields() {
      return request.resource.data.updatedBy == request.auth.uid &&
             request.resource.data.updatedAt == request.time;
    }

    // Tenants collection
    match /tenants/{tenantId} {
      allow read: if isAuthenticated() && belongsToSameTenant(tenantId);
      allow create: if hasRole('admin') && hasValidAuditFields();
      allow update: if hasRole('admin') && belongsToSameTenant(tenantId) && hasValidUpdateFields();
      allow delete: if false; // Tenants should not be deleted via client
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated() && (
        isOwner(userId) || 
        (hasRole('admin') && belongsToSameTenant(resource.data.tenantId)) ||
        (hasRole('supervisor') && belongsToSameTenant(resource.data.tenantId))
      );
      allow create: if hasRole('admin') && hasValidAuditFields() && belongsToSameTenant(request.resource.data.tenantId);
      allow update: if (
        isOwner(userId) || 
        (hasRole('admin') && belongsToSameTenant(resource.data.tenantId))
      ) && hasValidUpdateFields();
      allow delete: if hasRole('admin') && belongsToSameTenant(resource.data.tenantId);
    }

    // Sites collection
    match /sites/{siteId} {
      allow read: if isAuthenticated() && isValidTenantData();
      allow create: if (hasRole('admin') || hasRole('supervisor')) && 
                       hasValidAuditFields() && 
                       belongsToSameTenant(request.resource.data.tenantId);
      allow update: if (hasRole('admin') || hasRole('supervisor')) && 
                       isValidTenantData() && 
                       hasValidUpdateFields();
      allow delete: if hasRole('admin') && isValidTenantData();
    }

    // Patrol Points collection
    match /patrolPoints/{pointId} {
      allow read: if isAuthenticated() && isValidTenantData();
      allow create: if (hasRole('admin') || hasRole('supervisor')) && 
                       hasValidAuditFields();
      allow update: if (hasRole('admin') || hasRole('supervisor')) && 
                       hasValidUpdateFields();
      allow delete: if (hasRole('admin') || hasRole('supervisor'));
    }

    // Routes collection
    match /routes/{routeId} {
      allow read: if isAuthenticated() && isValidTenantData();
      allow create: if (hasRole('admin') || hasRole('supervisor')) && 
                       hasValidAuditFields();
      allow update: if (hasRole('admin') || hasRole('supervisor')) && 
                       hasValidUpdateFields();
      allow delete: if (hasRole('admin') || hasRole('supervisor'));
    }

    // Shifts collection
    match /shifts/{shiftId} {
      allow read: if isAuthenticated() && (
        isValidTenantData() ||
        isOwner(resource.data.guardId)
      );
      allow create: if (hasRole('admin') || hasRole('supervisor')) && 
                       hasValidAuditFields() && 
                       belongsToSameTenant(request.resource.data.tenantId);
      allow update: if (hasRole('admin') || hasRole('supervisor')) && 
                       isValidTenantData() && 
                       hasValidUpdateFields();
      allow delete: if (hasRole('admin') || hasRole('supervisor')) && isValidTenantData();
    }

    // Check-ins collection
    match /checkins/{checkinId} {
      allow read: if isAuthenticated() && (
        isValidTenantData() ||
        isOwner(resource.data.guardId)
      );
      allow create: if hasRole('guard') && 
                       isOwner(request.resource.data.guardId) &&
                       request.resource.data.createdBy == request.auth.uid;
      allow update: if false; // Check-ins should not be updated by clients
      allow delete: if false; // Check-ins should not be deleted
    }

    // Incidents collection
    match /incidents/{incidentId} {
      allow read: if isAuthenticated() && isValidTenantData();
      allow create: if (hasRole('guard') || hasRole('supervisor')) && 
                       hasValidAuditFields() && 
                       belongsToSameTenant(request.resource.data.tenantId);
      allow update: if (
        (hasRole('guard') && isOwner(resource.data.createdBy)) ||
        hasRole('supervisor') ||
        hasRole('admin')
      ) && isValidTenantData() && hasValidUpdateFields();
      allow delete: if hasRole('admin') && isValidTenantData();
    }

    // Alerts collection
    match /alerts/{alertId} {
      allow read: if isAuthenticated() && (
        isValidTenantData() ||
        isOwner(resource.data.guardId)
      );
      allow create: if hasRole('guard') && 
                       isOwner(request.resource.data.guardId) &&
                       request.resource.data.createdBy == request.auth.uid;
      allow update: if (hasRole('supervisor') || hasRole('admin')) && 
                       isValidTenantData() && 
                       hasValidUpdateFields();
      allow delete: if false; // Alerts should not be deleted
    }

    // Compliance tracking (read-only for clients, writable by functions)
    match /compliance/{complianceId} {
      allow read: if isAuthenticated() && isValidTenantData();
      allow write: if false; // Only cloud functions can write compliance data
    }

    // QR Sheets collection
    match /qrSheets/{sheetId} {
      allow read: if isAuthenticated() && isValidTenantData();
      allow create: if (hasRole('admin') || hasRole('supervisor')) && 
                       belongsToSameTenant(request.resource.data.tenantId);
      allow update: if false; // QR sheets are immutable once created
      allow delete: if hasRole('admin') && isValidTenantData();
    }

    // Notifications collection (read-only for users)
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && isValidTenantData();
      allow write: if false; // Only cloud functions can write notifications
    }

    // Block access to all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
