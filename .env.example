# Firebase Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# MapLibre/Maps Configuration (Optional)
VITE_MAPTILER_KEY=your_maptiler_api_key_here
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# App Configuration
VITE_APP_NAME=Wolves Security
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION=Multi-tenant security management platform

# Development Configuration
NODE_ENV=development
PORT=5000

# Database (NaborNet PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/nabornet

# Session Security
SESSION_SECRET=your-session-secret-here

# Rate Limiting Configuration (Phase 1 Enhancement)
RATE_LIMITS_INCIDENT_WINDOW_SEC=10
RATE_LIMITS_INCIDENT_ANON_WINDOW_SEC=20

# Proximity Deduplication
DEDUPE_RADIUS_METERS=100
DEDUPE_WINDOW_MINUTES=10

# Idempotency Support
IDEMPOTENCY_TTL_SEC=900

# Future: Redis Configuration (Phase 2)
# REDIS_URL=redis://default:password@localhost:6379

# Firebase Functions Service Account (for local development)
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account-key.json

# Email Configuration (for functions)
SENDGRID_API_KEY=your_sendgrid_api_key_here
FROM_EMAIL=noreply@wolvessecurity.com

# SMS Configuration (for functions)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Development URLs
VITE_DEV_URL=http://localhost:5000
